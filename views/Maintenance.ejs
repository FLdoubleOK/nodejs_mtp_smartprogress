<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./header.ejs') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Status Toggle</title>
</head>
<body>
  <div class="container mt-5">
    <h1 class="text-center">Toggle Status</h1>
    <div class="text-center mt-4">
      <form method="POST" action="/update-status">
        <button 
          type="submit" 
          name="status" 
          value="1" 
          class="btn btn-lg me-3 <% if (result[0].Status === 1) { %> btn-success <% } else { %> btn-secondary <% } %>">
          Online
        </button>
        <button 
          type="submit" 
          name="status" 
          value="0" 
          class="btn btn-lg <% if (result[0].Status === 0) { %> btn-danger <% } else { %> btn-secondary <% } %>">
          Offline
        </button>
      </form>
    </div>
  </div>
  <script src="../js/maintenance.js"></script>

</body>
</html>
