<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./header.ejs') %>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Status Toggle</title>
  </head>
  <body>
    <div
      class="container d-flex justify-content-center align-items-center"
      style="height: 100vh"
    >
      <div class="text-center">
        <!-- แสดงสถานะปัจจุบัน -->
        <h1 class="text-center mb-4">
          <% if (result[0].Status === 1) { %> Server is online <% } else { %>
          Server is offline <% } %>
        </h1>
        <h2 class="text-center mb-4">
          Last Update : <%= result[0].CreateDate %>
        </h2>
        <!-- ฟอร์มปุ่ม -->
        <form id="statusForm">
          <div class="mb-3">
            <label for="remarkInput" class="form-label"
              >Remark (required for offline):</label
            >
            <input
              type="text"
              id="remarkInput"
              class="form-control"
              placeholder="Enter your remark here"
            />
          </div>
          <input
            type="hidden"
            id="statusInput"
            name="status"
            value="<%= result[0].Status %>"
          />
          <button
            id="onlineBtn"
            type="button"
            class="btn btn-lg me-3 <% if (result[0].Status === 1) { %> btn-success <% } else { %> btn-secondary <% } %>"
          >
            Online
          </button>
          <button
            id="offlineBtn"
            type="button"
            class="btn btn-lg <% if (result[0].Status === 0) { %> btn-danger <% } else { %> btn-secondary <% } %>"
          >
            Offline
          </button>
        </form>
      </div>
    </div>

    <script src="../js/maintenance.js"></script>
  </body>
</html>
